{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JGP Meeting",
  "version": "0.2.1",
  "identifier": "com.jgp.meeting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JGP Meeting",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/silero_vad.onnx", "resources/onnxruntime.dll"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNjgxQ0Y1NzQ0QTBCRjcKUldUM0MwcDA5UnhvMjdGV1JOcklxQ0diMC9oMFpnbjg4WFpldXBYcFZEQUtUNWwwV3pEUHBhZmwK",
      "endpoints": [
        "https://github.com/AvivJGP/jgp-meeting/releases/latest/download/latest.json"
      ]
    }
  }
}
